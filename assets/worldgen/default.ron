// Oxium worldgen default configuration.
// Hot-reloaded by the file watcher (always on, including release builds).
// On parse failure, the engine logs and keeps using the previous config.

(
    density: (
        // World Y range — controls the y_gradient that biases density
        // toward solid below and air above the surface.
        y_min: -120,
        y_max: 140,
        y_gradient_amplitude: 1.5,

        // MC's formula: 4 * quarter_negative((depth + jagged) * factor)
        composition_scale: 4.0,
        above_surface_softening: 0.25,

        // PR 2: constant factor. PR 3 will swap this for a spline of
        // (continentalness, erosion, ridges). Higher → sharper surface,
        // lower → softer / flatter terrain.
        factor: 4.0,

        // Base 3D noise (anisotropic — y wavelength is half the xz).
        base_3d_period: 32.0,
        base_3d_amplitude: 1.0,
        base_3d_y_scale: 0.5,

        // Top slide: within 16 blocks of y_max, lerp density toward -0.078
        // (pull to air) so the world has a clean sky ceiling.
        slide_top_blocks: 16,
        slide_top_target: -0.078125,

        // Bottom slide: within 24 blocks of y_min, lerp density toward
        // +0.117 (pull to solid) so caves can't punch through to the void.
        slide_bottom_blocks: 24,
        slide_bottom_target: 0.1171875,

        // PR 2 placeholder: constant 0 offset. PR 3 makes this a spline
        // of continentalness with mountain/plain/ocean knots.
        offset_spline: Constant(0.0),
    ),

    // ── Climate / spline pipeline (PR 3) ──────────────────────────────
    //
    // Three 2D inputs drive nested cubic Hermite splines:
    //   continentalness ∈ [-1.1, 1.1]: -1 deep ocean, 0 coastline, +1 deep inland
    //   terrain_shape   ∈ [-1, 1]:    -1 mountainous, +1 flat (plus per-plate bias)
    //   ridges_pv       ∈ [-1, 1]:    PV fold; +1 = ridge peak
    //
    // Spline output is an `offset` in y_gradient units. The world Y
    // for a given offset is:
    //   y = y_min + (y_max - y_min) * (1 + offset / y_grad_amp) * 0.5
    // For Oxium's geometry (y_min=-120, y_max=140, amp=1.5):
    //   offset 0.10 → y= 18  (deep ocean floor)
    //   offset 0.35 → y= 40  (continental shelf)
    //   offset 0.55 → y= 58  (beach / just below sea level 62)
    //   offset 0.65 → y= 70  (just above sea level)
    //   offset 0.80 → y= 83  (lowland)
    //   offset 1.00 → y=100  (hills)
    //   offset 1.20 → y=115  (mountain)
    //   offset 1.40 → y=130  (high peak / snow cap)
    //
    // Knot shapes mirror Minecraft 1.18+ TerrainProvider.java but the
    // values are Oxium-calibrated (MC's coastline-bias constant is
    // baked directly into knot values here).
    climate: (
        // Per-plate roughness bias added to terrain_shape: more
        // negative = mountains. Preserves "rocky vs gentle continent"
        // identity even with a smooth shape noise field.
        plate_roughness_bias_range: (-0.25, 0.25),
        terrain_shape_period: 2000.0,
        terrain_shape_amplitude: 1.0,
        ridges_period: 500.0,
        ridges_amplitude: 1.0,

        // offset_spline: continentalness → surface offset.
        // Outer knot values are scalars (deep ocean / coast) or
        // inner Multipoint splines on terrain_shape (deep inland).
        offset_spline: Multipoint([
            // Mushroom-cap saturation cap above deep ocean.
            (loc: -1.10, val: Constant(0.30),  slope: 0.0),
            // Deep ocean floor — flat plateau between -1.02 and -0.51.
            (loc: -1.02, val: Constant(0.10),  slope: 0.0),
            (loc: -0.51, val: Constant(0.10),  slope: 0.0),
            // Continental shelf (gradually shallowing toward coast).
            (loc: -0.30, val: Constant(0.30),  slope: 0.0),
            (loc: -0.10, val: Constant(0.45),  slope: 0.0),
            // Coastline (c≈0 = C-O plate boundary). Hard step into
            // beach via duplicated location (MC's trick).
            (loc: -0.02, val: Constant(0.55),  slope: 0.0),
            (loc:  0.02, val: Constant(0.62),  slope: 0.0),
            // Lowlands (c=+0.10): terrain_shape-driven hills.
            (loc:  0.10, val: Multipoint([
                (loc: -0.85, val: Constant(0.85), slope: 0.0),  // low-erosion hill
                (loc: -0.40, val: Constant(0.78), slope: 0.0),
                (loc:  0.20, val: Constant(0.70), slope: 0.0),
                (loc:  0.70, val: Constant(0.65), slope: 0.0),  // high-erosion plain
            ]), slope: 0.0),
            // Mid-inland (c=+0.30): bigger range.
            (loc:  0.30, val: Multipoint([
                (loc: -0.85, val: Constant(1.05), slope: 0.0),  // hill
                (loc: -0.40, val: Constant(0.92), slope: 0.0),
                (loc:  0.20, val: Constant(0.80), slope: 0.0),  // plain
                (loc:  0.70, val: Constant(0.70), slope: 0.0),
            ]), slope: 0.0),
            // Far inland (c=+0.70): mountain ranges become available.
            (loc:  0.70, val: Multipoint([
                (loc: -0.85, val: Constant(1.30), slope: 0.0),  // mountain
                (loc: -0.40, val: Constant(1.10), slope: 0.0),
                (loc:  0.20, val: Constant(0.90), slope: 0.0),
                (loc:  0.70, val: Constant(0.75), slope: 0.0),
            ]), slope: 0.0),
            // Deep continental (c=+1.00): high peaks possible.
            (loc:  1.00, val: Multipoint([
                (loc: -0.85, val: Constant(1.42), slope: 0.0),  // high peak
                (loc: -0.40, val: Constant(1.20), slope: 0.0),
                (loc:  0.20, val: Constant(1.00), slope: 0.0),
                (loc:  0.70, val: Constant(0.80), slope: 0.0),
            ]), slope: 0.0),
        ]),

        // factor_spline: multiplier on the (depth + jagged * noise)
        // term. Higher = sharper vertical transition (steeper cliffs).
        // Values match MC's TerrainProvider.getErosionFactor scales.
        factor_spline: Multipoint([
            (loc: -0.30, val: Constant(3.95), slope: 0.0),  // ocean: flat-ish
            (loc: -0.10, val: Constant(4.50), slope: 0.0),  // shelf
            (loc:  0.10, val: Multipoint([
                (loc: -0.85, val: Constant(5.50), slope: 0.0),
                (loc:  0.20, val: Constant(4.69), slope: 0.0),
            ]), slope: 0.0),
            (loc:  0.50, val: Multipoint([
                (loc: -0.85, val: Constant(6.25), slope: 0.0),  // sharp peaks
                (loc:  0.20, val: Constant(5.08), slope: 0.0),
            ]), slope: 0.0),
            (loc:  1.00, val: Multipoint([
                (loc: -0.85, val: Constant(6.25), slope: 0.0),
                (loc:  0.20, val: Constant(5.08), slope: 0.0),
            ]), slope: 0.0),
        ]),

        // jaggedness_spline: amplitude of the high-frequency rider.
        // Active only at peaks (high ridges_pv, low terrain_shape,
        // far inland). Multiplied by base_3d_noise → adds ±0.3-0.5
        // to depth at peaks, creating jagged mountain detail.
        jaggedness_spline: Multipoint([
            (loc:  0.05, val: Constant(0.0), slope: 0.0),
            (loc:  0.50, val: Multipoint([
                // terrain_shape: low (mountains) = jagged, high = smooth
                (loc: -0.85, val: Multipoint([
                    // ridges_pv: peaks have jaggedness, valleys don't
                    (loc: -0.5, val: Constant(0.0), slope: 0.0),
                    (loc:  0.5, val: Constant(0.30), slope: 0.0),
                ]), slope: 0.0),
                (loc:  0.20, val: Constant(0.0), slope: 0.0),
            ]), slope: 0.0),
            (loc:  1.00, val: Multipoint([
                (loc: -0.85, val: Multipoint([
                    (loc: -0.5, val: Constant(0.0), slope: 0.0),
                    (loc:  0.5, val: Constant(0.50), slope: 0.0),
                ]), slope: 0.0),
                (loc:  0.20, val: Constant(0.0), slope: 0.0),
            ]), slope: 0.0),
        ]),
    ),

    // ── Biome hyperbox claims (PR 4) ────────────────────────────────────
    //
    // Each entry stakes out a region of the 6D climate space
    // (temperature, humidity, continentalness, terrain_shape, depth,
    // weirdness). A query lands in the biome whose hyperbox is
    // nearest by squared-L2 distance — see climate::RTree.
    //
    // The parameter ranges are stored as quantized i64 (raw value
    // × 10000). E.g. min: -10000 == raw -1.0.
    biomes: (
        weirdness_period: 800.0,
        weirdness_amplitude: 1.0,
        entries: [
            // Tundra — cold, dry to medium humidity, any other axis.
            (
                temperature:    (min: -20000, max: -3000),
                humidity:       (min: -20000, max:  3000),
                continentalness:(min: -20000, max: 20000),
                terrain_shape:  (min: -20000, max: 20000),
                depth:          (min: -20000, max: 20000),
                weirdness:      (min: -20000, max: 20000),
                offset: 0,
                biome: Tundra,
            ),
            // SnowyForest — cold + humid. Same cold range, humidity > 0.
            (
                temperature:    (min: -20000, max: -3000),
                humidity:       (min:  0,     max: 20000),
                continentalness:(min: -20000, max: 20000),
                terrain_shape:  (min: -20000, max: 20000),
                depth:          (min: -20000, max: 20000),
                weirdness:      (min: -20000, max: 20000),
                offset: 0,
                biome: SnowyForest,
            ),
            // Plains — temperate + dry.
            (
                temperature:    (min: -3000,  max:  3000),
                humidity:       (min: -20000, max:  500),
                continentalness:(min: -20000, max: 20000),
                terrain_shape:  (min: -20000, max: 20000),
                depth:          (min: -20000, max: 20000),
                weirdness:      (min: -20000, max: 20000),
                offset: 0,
                biome: Plains,
            ),
            // Forest — temperate + humid.
            (
                temperature:    (min: -3000,  max:  3000),
                humidity:       (min:   500,  max: 20000),
                continentalness:(min: -20000, max: 20000),
                terrain_shape:  (min: -20000, max: 20000),
                depth:          (min: -20000, max: 20000),
                weirdness:      (min: -20000, max: 20000),
                offset: 0,
                biome: Forest,
            ),
            // Desert — hot.
            (
                temperature:    (min:  3000,  max: 20000),
                humidity:       (min: -20000, max:  2000),
                continentalness:(min: -20000, max: 20000),
                terrain_shape:  (min: -20000, max: 20000),
                depth:          (min: -20000, max: 20000),
                weirdness:      (min: -20000, max: 20000),
                offset: 0,
                biome: Desert,
            ),
            // Tropical — hot + humid.
            (
                temperature:    (min:  2000,  max: 20000),
                humidity:       (min:  2000,  max: 20000),
                continentalness:(min: -20000, max: 20000),
                terrain_shape:  (min: -20000, max: 20000),
                depth:          (min: -20000, max: 20000),
                weirdness:      (min: -20000, max: 20000),
                offset: 0,
                biome: Tropical,
            ),
        ],
    ),

    // ── Surface block rule tree (PR 6) ──────────────────────────────────
    //
    // Walked once per voxel by `SurfaceSystem::surface_block`.
    // `Sequence` is short-circuit OR; `If` is short-circuit AND.
    // First matching `Block` wins.
    //
    // The rule tree below mirrors the pre-PR-6 inline selector
    // exactly, just expressed declaratively. Edit knobs:
    //   * `WithinSurfaceBand(16)` → cliff/non-surface fall through to Stone
    //   * `BeachBand(below_sea: 1, above_sea: 2)` → 4-block-wide beach
    //   * `YAbove(110)` → alpine snow line
    //   * `IsCold AND YAbove(70)` → cold-biome snow cap floor
    surface: Sequence([
        // 1. Cliff faces → Stone (regardless of depth).
        If(condition: IsCliff,             then: Block(Stone)),
        // 2. Outside the surface band → Stone. The chunk-cycle
        //    depth-reset bug fix: deep underground "depth==0"
        //    voxels (from chunk-y reset or cave floors) don't get
        //    grass.
        If(condition: Not(WithinSurfaceBand(16)), then: Block(Stone)),
        // 3. Topmost solid (depth == 0): pick the surface material.
        //    Requires the voxel to be AT OR ABOVE the column's
        //    heightmap — otherwise a cave roof (where a transition
        //    from cave-air to rock happens BELOW the heightmap)
        //    would falsely fire the surface rule and stamp grass
        //    on the underside of a cave. The OnFloor + above-h
        //    pair is the cheap "is this really the topmost block
        //    of the natural column" gate.
        If(
            condition: All([OnFloor, AbovePreliminarySurface(-1)]),
            then: Sequence([
            // Beach band around sea level (and not snow-capped biome).
            If(
                condition: All([
                    BeachBand(below_sea: 1, above_sea: 2),
                    Not(IsCold),
                ]),
                then: Block(Sand),
            ),
            // Alpine snow line — applies to any biome.
            If(condition: YAbove(110), then: Block(Snow)),
            // Cold-biome snow cap.
            If(
                condition: All([IsCold, YAbove(70)]),
                then: Block(Snow),
            ),
            // Desert biome: sand surface.
            If(
                condition: Biome([Desert]),
                then: Block(Sand),
            ),
            // Default surface: Grass.
            Block(Grass),
        ])),
        // 3b. Below the heightmap, a depth==0 transition is a cave
        //     roof — treat it as Stone, not as a surface.
        If(condition: OnFloor, then: Block(Stone)),
        // 4. Sub-surface: 1-3 blocks below topmost = Dirt — but
        //     only when we're actually near the heightmap (the
        //     natural grass cap). Without the AbovePreliminarySurface
        //     gate, the 3 voxels under any cave roof would also
        //     become Dirt.
        If(
            condition: All([UnderFloor(3), AbovePreliminarySurface(-4)]),
            then: Block(Dirt),
        ),
        // 5. Default fallthrough: Stone.
        Block(Stone),
    ]),

    // ── Noise carvers: cheese / pillars ─────────────────────────────
    //
    // Ambient noise-driven cave density that runs alongside the
    // graph cave systems. Topology (which noise channels exist, how
    // they compose) stays in Rust; only the numeric values are
    // hot-reloadable from this file.
    cave: (
        // ── Cheese: signed-density carver.
        //   cheese = clamp(offset + cheese_noise, -1, 1)
        //            + clamp(supp_offset + supp_slope * raw_density,
        //                    supp_min, supp_max)
        // Voxels carve where the result goes negative. The
        // suppression term pushes things solid near the surface
        // (raw_density ≈ 0) and dies off at depth, so cheese only
        // carves deep underground.
        cheese: (
            first_octave: -8,
            amplitudes: [0.5, 1.0, 2.0, 1.0, 2.0, 1.0, 0.0, 2.0, 0.0],
        ),
        // MC parity: xz=1.0, y=0.6667 → cheese features are TALLER
        // than wide (vertical caverns), not the flat sphere-shaped
        // donut pockets the previous isotropic sampling produced.
        cheese_xz_scale: 1.0,
        cheese_y_scale: 0.6666667,
        cheese_offset: 0.27,
        cheese_suppression_offset: 1.5,
        cheese_suppression_slope: -0.64,
        cheese_suppression_min: 0.0,
        cheese_suppression_max: 0.5,

        // cave_layer: regional gating for cheese. Sampled at
        // (xz=1.0, y=8.0) — Y advances 8× faster than XZ, producing
        // horizontal strata. `cave_layer_intensity * layer²` is
        // added to cheese: cave-rich bands (|layer|≈0) carve;
        // cave-poor bands stay solid. Without this term cheese
        // carves ~50% of deep voxels uniformly.
        cave_layer: (
            first_octave: -8,
            amplitudes: [1.0],
        ),
        cave_layer_xz_scale: 1.0,
        cave_layer_y_scale: 8.0,
        cave_layer_intensity: 6.0,

        // ── Pillars: positive-density blobs that get max()'d
        //     after cave subtraction so they refill carved voxels.
        pillar: (
            first_octave: -7,
            amplitudes: [1.0, 1.0],
        ),
        pillar_rareness: (
            first_octave: -8,
            amplitudes: [1.0],
        ),
        pillar_thickness: (
            first_octave: -8,
            amplitudes: [1.0],
        ),
        pillar_xz_scale: 25.0,
        pillar_y_scale: 0.3,
        pillar_cutoff: 0.03,
        pillar_intensity: 4.0,

        // Density threshold for the noise carvers to operate.
        // 0.0 means "any voxel that's nominally solid". Cheese's
        // own surface-suppression term keeps cheese pockets from
        // blooming through the surface.
        underground_density_threshold: 0.0,

        // ── Terasology depth-driven ambient ─────────────────────────
        // Two 4-octave FBM-Simplex channels whose |cross-product|
        // defines meandering tube cave regions. Carver is wired in
        // PR1.5; these values set the noise shape and thresholds.
        tera_a: (first_octave: 0, amplitudes: [1.0, 0.5, 0.25, 0.125]),
        tera_b: (first_octave: 0, amplitudes: [1.0, 0.5, 0.25, 0.125]),
        tera_wave: 200.0,
        tera_supp: 0.17,
        tera_supp_depth: 123.0,
        tera_thresh_base: 0.073,
        tera_thresh_depth: 2229.0,
        tera_y_factor: 3.56,

        style_table: (
            cathedral_chamber_count: (3, 5),
            warren_chamber_count: (9, 13),
            slot_chamber_count: (5, 8),
            sump_chamber_count: (4, 7),
            karst_chamber_count: (6, 10),
            cathedral_r_xz: (22.0, 32.0), warren_r_xz: (6.0, 12.0),
            slot_r_xz: (10.0, 24.0),      sump_r_xz: (14.0, 24.0),
            karst_r_xz: (10.0, 18.0),
            cathedral_r_y: (16.0, 26.0),  warren_r_y: (5.0, 10.0),
            slot_r_y: (4.0, 8.0),         sump_r_y: (8.0, 14.0),
            karst_r_y: (8.0, 14.0),
            cathedral_tunnel_r: (4.0, 6.0), warren_tunnel_r: (3.0, 4.0),
            slot_tunnel_r: (3.0, 5.0),     sump_tunnel_r: (4.0, 6.0),
            karst_tunnel_r: (3.0, 5.0),
            style_weights_shallow: (0.05, 0.45, 0.20, 0.05, 0.25),
            style_weights_middle:  (0.20, 0.20, 0.20, 0.20, 0.20),
            style_weights_deep:    (0.10, 0.05, 0.05, 0.45, 0.35),
        ),
        depth_scale: 0.81,
        deep_band_bias: 0.30,
        systems_per_region_max: 3,
        chamber_radius_jitter: (0.7, 1.3),
    ),

    // ── Aquifer system (PR 7) ────────────────────────────────────────
    //
    // 16×12×16 jittered cell grid. Each cell rolls a fluid kind
    // (Water/Lava) and a `y_top` (the fluid surface in that cell).
    // For an arbitrary voxel, the system finds the three nearest
    // cells; if the closest one is at or below its `y_top` and the
    // 3-nearest agree on fluid, the voxel becomes fluid (overriding
    // density). If they disagree, a 3D barrier noise breaks the tie
    // — giving the fluid boundary a chiseled, ribbon-like shape
    // instead of a flat plane.
    //
    // Lava cells appear only below `LAVA_BAND_TOP_Y` (-32) in
    // worldgen::aquifer. Above sea level, cells are sentinel-dry so
    // there are no "sky aquifers".
    aquifer: (
        // Sea level used as a cap for water-aquifer `y_top`. Must
        // match worldgen::SEA_LEVEL or the upper bound disagrees
        // with the ocean's flood level.
        sea_level: 62,

        // Y-jitter applied to each cell's nominal y_top. Larger →
        // more dramatic perched aquifers / wet-dry stripe variation
        // between adjacent cells.
        y_top_jitter: 6,

        // 3D barrier noise (modulates fluid-surface shape).
        // strength=0 ⇒ flat planes; ~0.5 ⇒ wavy boundaries.
        barrier_strength: 0.5,
        barrier_period: 24.0,

        // Asymmetric falloff above/below the cell's `y_top`. Above
        // is quadratic (cuts off fast); below is linear (taper). MC
        // uses similar asymmetry — water sinks but doesn't pile up.
        top_falloff: 0.06,
        bottom_falloff: 0.012,
    ),
)
